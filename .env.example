# Copy to .env in this directory (gitignored). Loaded into containers via docker-compose.override.yml.
# Reference in ~/.nanobot/config.json with ${VAR} placeholders (resolved at startup, not stored on save).

OPENROUTER_API_KEY=
HF_TOKEN=

# Docker build: WEB_GUARD defaults to false. Opt in with:
#   ./build-nanobot.sh web-guard
# Runtime when built without web-guard (optional):
# NANOBOT_WEB_FETCH_GUARD=0
# NANOBOT_MEMORY_LIMIT=1G

# Host path for ttswrapper output (mounted to workspace media/tts in the container).
# TTS_OUTPUT_HOST=/Users/panuhallfors/tools/ttswrapper/data/output

# Host path for spotify-mcp (mounted to /home/nanobot/tools/spotify-mcp in the container).
# SPOTIFY_MCP_HOST=/Users/panuhallfors/tools/spotify-mcp
